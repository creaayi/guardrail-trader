# Copy to .env and fill in. Never commit .env.

# --- LLM: pick ONE provider -------------------------------------------------
LLM_PROVIDER=anthropic            # anthropic | openrouter
ANTHROPIC_API_KEY=                # if LLM_PROVIDER=anthropic
OPENROUTER_API_KEY=               # if LLM_PROVIDER=openrouter (leave ANTHROPIC_API_KEY empty)
# Model: blank = default (claude-sonnet-5 / anthropic/claude-sonnet-5).
# Cheaper: claude-haiku-4-5-20251001 (anthropic) or anthropic/claude-haiku-4.5 (openrouter)
CLAUDE_MODEL=
# Spend guardrails (USD), enforced in code from actual token usage:
LLM_RUN_BUDGET_USD=0.10
LLM_MONTHLY_BUDGET_USD=2.50
LLM_REQUEST_TIMEOUT_S=60          # per API call; SDK default is 10 min
AGENT_MAX_SECONDS=300             # wall-clock budget for the agent loop (over = no trades)
ENABLE_WEB_SEARCH=0               # 1 = Claude may search news (US$0.01/search, max 5/run)

# --- Broker ------------------------------------------------------------------
# paper | live   (live is the owner's explicit switch; code refuses mismatched port/account)
TRADING_MODE=paper
# IB Gateway: paper 4002, live 4001 | TWS: paper 7497, live 7496
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1
# 1=live (needs subscription) 3=delayed (free)
IBKR_MARKET_DATA_TYPE=3

# --- Alerts (ntfy) -------------------------------------------------------------
# The topic is a secret: anyone who knows it can read the alerts. Pick a long random one.
NTFY_TOPIC=
# NTFY_URL=https://ntfy.sh        # default; set it for a self-hosted server

# --- Dry-run week (T10) ----------------------------------------------------------
# 1 = every scheduled run is --dry-run and each decision slot runs twice (scripts/consistency.py).
# Remove at day 0 (docs/dry-run-week.md).
SCHEDULER_DRY_RUN=0
